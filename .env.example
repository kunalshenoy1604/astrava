# ── Site ────────────────────────────────────────────────────────────────
# Canonical origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ── Supabase ────────────────────────────────────────────────────────────
# Leave empty to run on the clearly-labelled demo dataset (no accounts).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (or legacy anon) key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the ingestion pipeline and seed script. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Show "Continue with Google" (enable the Google provider in Supabase Auth first).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# ── Ingestion pipeline ─────────────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. At least 16 characters.
CRON_SECRET=
# Optional but recommended: raises GitHub API rate limits.
GITHUB_TOKEN=
# Optional Hugging Face token.
HF_TOKEN=
# Comma-separated adapter ids to run (default: all enabled): github,arxiv,hackernews,huggingface,npm,rss
PIPELINE_ENABLED_SOURCES=
# GitHub search qualifiers (a "created:>" and "stars:>" filter are appended).
PIPELINE_GITHUB_QUERY=
# arXiv categories, space-separated.
PIPELINE_ARXIV_CATEGORIES=cs.AI cs.LG cs.CL cs.RO cs.CR cs.DC quant-ph
# npm keywords to search, comma-separated.
PIPELINE_NPM_KEYWORDS=llm,ai-agent,mcp,inference,webgpu
# Official feeds: comma-separated "Publisher|https://feed.url" pairs.
PIPELINE_RSS_FEEDS=
# Identify your deployment to source APIs (include a contact URL).
PIPELINE_USER_AGENT=AstravaSignalPipeline/1.0 (+https://your-domain.example/about)
